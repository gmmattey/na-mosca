{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/room/**",
              "components/social/**",
              "ui_kits/chuta-essa/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Barlow|Barlow Condensed))/i]",
        "message": "Font not provided by the design system. Available: Barlow, Barlow Condensed."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|children|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, children, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|light)$/]",
        "message": "<Chip> tone must be one of 'neutral' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GuessInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|unit|onChange|key|ref|className|style|children)$/]",
        "message": "<GuessInput> doesn't accept that prop. Declared props: value, unit, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProximityBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|key|ref|className|style|children)$/]",
        "message": "<ProximityBadge> doesn't accept that prop. Declared props: state."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProximityBadge'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:cravou|muito_perto|razoavel|longe)$/]",
        "message": "<ProximityBadge> state must be one of 'cravou' | 'muito_perto' | 'razoavel' | 'longe'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProximityScale'] > JSXAttribute > JSXIdentifier[name!=/^(?:guessPct|answerPct|exact|key|ref|className|style|children)$/]",
        "message": "<ProximityScale> doesn't accept that prop. Declared props: guessPct, answerPct, exact."
      },
      {
        "selector": "JSXOpeningElement[name.name='RankRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:position|name|points|highlight|key|ref|className|style|children)$/]",
        "message": "<RankRow> doesn't accept that prop. Declared props: position, name, points, highlight."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoomCodeCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|players|key|ref|className|style|children)$/]",
        "message": "<RoomCodeCard> doesn't accept that prop. Declared props: code, players."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScoreCounter'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|size|key|ref|className|style|children)$/]",
        "message": "<ScoreCounter> doesn't accept that prop. Declared props: value, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScoreCounter'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<ScoreCounter> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShareCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:headline|sub|key|ref|className|style|children)$/]",
        "message": "<ShareCard> doesn't accept that prop. Declared props: headline, sub."
      },
      {
        "selector": "JSXOpeningElement[name.name='Timer'] > JSXAttribute > JSXIdentifier[name!=/^(?:secondsLeft|secondsTotal|key|ref|className|style|children)$/]",
        "message": "<Timer> doesn't accept that prop. Declared props: secondsLeft, secondsTotal."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Button": {"replaces": []},
      "Chip": {"replaces": []},
      "GuessInput": {"replaces": []},
      "Icon": {"replaces": []},
      "ProximityBadge": {"replaces": []},
      "ProximityScale": {"replaces": []},
      "RankRow": {"replaces": []},
      "RoomCodeCard": {"replaces": []},
      "ScoreCounter": {"replaces": []},
      "ShareCard": {"replaces": []},
      "Timer": {"replaces": []}
    },
    "tokens": ["--accent-distance","--accent-info","--accent-primary","--bg-dark","--blue","--border-on-dark","--border-on-light","--cta-bg","--cta-bg-hover","--cta-bg-press","--cta-text","--dur-base","--dur-celebrate","--dur-fast","--dur-slow","--ease-in-out","--ease-out","--ease-spring","--font-body","--font-display","--light","--lime","--orange","--proximity-close","--proximity-exact","--proximity-far","--proximity-mid","--radius-lg","--radius-md","--radius-pill","--radius-sm","--ring-focus","--shadow-float","--space-1","--space-2","--space-3","--space-4","--space-5","--space-6","--space-7","--space-8","--space-9","--surface-game","--surface-game-raised","--surface-light","--surface-light-raised","--text-body","--text-body-sm","--text-button","--text-dark","--text-display-1","--text-guess","--text-h1","--text-h2","--text-label","--text-light","--text-on-dark","--text-on-dark-muted","--text-on-light","--text-on-light-muted","--text-question","--tracking-label"],
    "tokenKinds": {
      "--lime":"color","--bg-dark":"color","--blue":"color","--orange":"color","--light":"color","--text-light":"font","--text-dark":"font","--surface-game":"color","--surface-game-raised":"color","--surface-light":"color","--surface-light-raised":"color","--text-on-dark":"font","--text-on-dark-muted":"font","--text-on-light":"font","--text-on-light-muted":"font","--accent-primary":"color","--accent-info":"color","--accent-distance":"color","--cta-bg":"color","--cta-text":"font","--cta-bg-hover":"color","--cta-bg-press":"color","--border-on-dark":"color","--border-on-light":"color","--proximity-exact":"color","--proximity-close":"color","--proximity-mid":"color","--proximity-far":"color","--font-display":"font","--font-body":"font","--text-guess":"font","--text-display-1":"font","--text-h1":"font","--text-h2":"font","--text-question":"font","--text-body":"font","--text-body-sm":"font","--text-label":"font","--text-button":"font","--tracking-label":"font","--space-1":"spacing","--space-2":"spacing","--space-3":"spacing","--space-4":"spacing","--space-5":"spacing","--space-6":"spacing","--space-7":"spacing","--space-8":"spacing","--space-9":"spacing","--radius-sm":"radius","--radius-md":"radius","--radius-lg":"radius","--radius-pill":"radius","--ease-out":"other","--ease-in-out":"other","--ease-spring":"other","--dur-fast":"other","--dur-base":"other","--dur-slow":"other","--dur-celebrate":"other","--shadow-float":"shadow","--ring-focus":"shadow"
    },
    "fontFamilies": ["Barlow","Barlow Condensed"]
  }
}